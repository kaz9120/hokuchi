{
  "name": "hokuchi",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "node apps/slides/dev.mjs",
    "check": "node packages/stage/cli.mjs check",
    "build": "node packages/stage/cli.mjs build",
    "studio": "node apps/studio/server.mjs",
    "site": "node apps/slides/build.mjs",
    "deploy": "node apps/slides/build.mjs && cd apps/slides && bunx wrangler deploy",
    "typecheck": "tsc -p packages/stage/tsconfig.json"
  }
}
