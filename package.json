{
  "name": "hokuchi",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "tools/eyecatch"],
  "scripts": {
    "dev": "node apps/slides/dev.mjs",
    "check": "node packages/stage/cli.mjs check",
    "build": "node packages/stage/cli.mjs build",
    "single": "node packages/stage/cli.mjs single",
    "studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/studio/server/main.ts",
    "eyecatch": "node tools/eyecatch/cli.mjs",
    "test:eyecatch": "node tools/eyecatch/test/check.mjs",
    "site":"node apps/slides/build.mjs",
    "deploy": "node apps/slides/build.mjs && cd apps/slides && bunx wrangler deploy",
    "typecheck": "tsc -p packages/stage/tsconfig.json && tsc -p apps/studio/tsconfig.json",
    "test:studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test apps/studio/test/studio.test.ts apps/studio/test/contract.test.ts"
  }
}
