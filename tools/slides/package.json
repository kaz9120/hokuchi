{
  "name": "@hokuchi/slides",
  "version": "0.1.0",
  "description": "hokuchi slide schema CLI — parse / lint / render intent-declared decks",
  "type": "module",
  "bin": {
    "hokuchi": "./cli.mjs"
  },
  "scripts": {
    "test": "node test/check.mjs",
    "lint:example": "node cli.mjs lint examples/intent-talk/deck.yaml",
    "render:example": "node cli.mjs render examples/intent-talk/deck.yaml -o out-example",
    "shot:example": "node cli.mjs shot out-example",
    "lint:coverage": "node cli.mjs lint examples/coverage/deck.yaml",
    "render:coverage": "node cli.mjs render examples/coverage/deck.yaml -o out-coverage",
    "shot:coverage": "node cli.mjs shot out-coverage",
    "serve:coverage": "node cli.mjs serve out-coverage"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "ajv": "^8.17.1",
    "budoux": "^0.6.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "agentation": "^3.0.2",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
