{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hokuchi.dev/schema/theme.schema.json",
  "title": "hokuchi slide theme",
  "description": "hokuchi スライドスキーマの Theme 仕様 (SPEC §2)。色・書体・グリッドを名前付きスロットに固定する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "palette", "type", "iconography", "space"],
      "properties": {
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "pattern": { "enum": ["col-3", "col-4", "col-5", "fibonacci"] },
            "rows": { "type": "integer", "minimum": 1, "default": 6 }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["core", "neutral", "highlight", "background"],
          "properties": {
            "core": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/hexColor" }
            },
            "neutral": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bg", "surface", "line", "muted", "text", "text_strong"],
              "properties": {
                "bg": { "$ref": "#/$defs/hexColor" },
                "surface": { "$ref": "#/$defs/hexColor" },
                "line": { "$ref": "#/$defs/hexColor" },
                "muted": { "$ref": "#/$defs/hexColor" },
                "text": { "$ref": "#/$defs/hexColor" },
                "text_strong": { "$ref": "#/$defs/hexColor" }
              }
            },
            "highlight": { "$ref": "#/$defs/hexColor" },
            "background": { "enum": ["dark", "light"] }
          }
        },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "body"],
          "properties": {
            "webfonts": {
              "type": "array",
              "items": { "type": "string" },
              "description": "<link> で読み込む Web フォント CSS の URL (ADR-0010)"
            },
            "display": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "weight"],
              "properties": {
                "family": { "type": "string" },
                "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
              }
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "weight", "min_size_pt"],
              "properties": {
                "family": { "type": "string" },
                "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "min_size_pt": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "scale": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hero": { "type": "integer", "minimum": 1, "default": 80 },
                "title": { "type": "integer", "minimum": 1, "default": 74 },
                "big": { "type": "integer", "minimum": 1, "default": 70 },
                "quote": { "type": "integer", "minimum": 1, "default": 46 },
                "heading": { "type": "integer", "minimum": 1, "default": 34 },
                "bullet": { "type": "integer", "minimum": 1, "default": 34 },
                "subtitle": { "type": "integer", "minimum": 1, "default": 30 },
                "attribution": { "type": "integer", "minimum": 1, "default": 24 },
                "node": { "type": "integer", "minimum": 1, "default": 24 },
                "axis": { "type": "integer", "minimum": 1, "default": 20 }
              }
            }
          }
        },
        "iconography": { "enum": ["isometric", "flat", "hand-drawn"] },
        "icon_set": { "enum": ["phosphor"], "description": "iconography 様式を実装するアイコンセット (ADR-0013)。デッキはアイコンを名前で参照する" },
        "icon_weight": { "enum": ["thin", "light", "regular", "bold", "fill", "duotone"], "default": "regular", "description": "通常時のウェイト。emphasis されたノードは 1 段階重いウェイトに導出される" },
        "space": { "enum": ["2d", "3d"] },
        "brand": {
          "description": "組織テーマのブランド枠 (ADR-0010)。ロゴ・フッタ・背景アート。パスはテーマファイルからの相対。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["src"],
              "properties": {
                "src": { "type": "string" },
                "src_invert": { "type": "string", "description": "反転背景 (foreground: light) 用の白版ロゴ" },
                "height": { "type": "integer", "minimum": 8, "default": 24 },
                "placement": { "enum": ["bumpers", "all"], "default": "bumpers" }
              }
            },
            "footer": { "type": "string", "description": "全スライド右下の短いテキスト (コピーライト等)" },
            "backgrounds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bumper": { "$ref": "#/$defs/background" },
                "title": { "$ref": "#/$defs/background" },
                "transition": { "$ref": "#/$defs/background" },
                "content": { "$ref": "#/$defs/background" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src"],
      "properties": {
        "src": { "type": "string" },
        "foreground": { "enum": ["light"], "description": "濃色背景の宣言。前景 (テキスト・ロゴ) を白系に反転する" }
      }
    }
  }
}
