{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@hokuchi/stage": ["./src/index.ts"],
      "@hokuchi/stage/*": ["./src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "motion/react": ["./node_modules/motion/dist/react.d.ts"]
    }
  },
  "include": ["src", "app", "examples", "../../talks/*/talk.tsx", "../../talks/*/scenes"]
}
